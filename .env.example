# Local demonstration mode. No credentials required.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Enable the external AI provider by setting LLM_PROVIDER=gemini and filling in key and tariffs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_INPUT_PRICE_PER_1M=
GEMINI_OUTPUT_PRICE_PER_1M=
GEMINI_DAILY_REQUEST_LIMIT=30
GEMINI_DAILY_BUDGET_USD=2.00

WEEKLY_TOKEN_LIMIT=100000
MAX_UPLOAD_MB=20
MAX_PAGES_PER_GENERATION=60
COOKIE_SECURE=false

# Optional: use an absolute path to a separate data directory.
# STUDYFORGE_DATA_DIR=

# Optional: defaults to the tessdata subfolder of STUDYFORGE_DATA_DIR.
# OCR_TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata

